generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String?  // Nullable for Google OAuth users
  name          String
  role          String    @default("STUDENT") // STUDENT, TEACHER, ADMIN
  xp            Int       @default(0)
  level         Int       @default(1)
  streak        Int       @default(0)
  avatar        String?
  googleId      String?   @unique
  authProvider  String    @default("local") // local, google
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  achievements  Achievement[]
  progress      Progress[]
  createdMaterials Material[] @relation("CreatedMaterials")
  teachingClasses  Class[]    @relation("TeachingClasses")
  enrolledClasses  ClassEnrollment[]
  classAchievements StudentClassAchievement[]
  exerciseAttempts  ExerciseAttempt[]
}

model Material {
  id              String    @id @default(uuid())
  title           String
  type            String    // video, book, quiz, article
  category        String    // Matematika, Fisika, etc.
  level           String    @default("Mudah") // Mudah, Menengah, Sulit
  content         String?   // JSON or markdown content
  semester        Int       @default(1)
  grade           Int       @default(10) // 10, 11, 12
  
  // Curriculum fields
  moduleId        String?
  module          Module?   @relation(fields: [moduleId], references: [id])
  moduleOrder     Int?      // Order within the module

  // Quiz linking fields
  linkedQuizId    String?   // ID materi quiz yang terhubung
  linkedQuiz      Material? @relation("MaterialToQuiz", fields: [linkedQuizId], references: [id])
  linkedFromMaterials Material[] @relation("MaterialToQuiz")
  minPassingScore Int?      @default(70) // Nilai minimal kelulusan (0-100)
  order           Int?      // Urutan materi dalam pembelajaran
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  createdBy   User      @relation("CreatedMaterials", fields: [createdById], references: [id])
  createdById String
  progress    Progress[]
}

model Module {
  id          String    @id @default(uuid())
  title       String
  description String?
  grade       Int
  semester    Int
  subject     String    // Category (Matematika, etc.)
  classId     String?
  class       Class?    @relation(fields: [classId], references: [id])
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  materials   Material[]
}

model Class {
  id              String    @id @default(uuid())
  name            String
  subject         String    @default("Umum")
  description     String?
  code            String    @unique
  isPublic        Boolean   @default(false)
  progressionMode String    @default("sequential") // "sequential" | "free"
  thumbnail       String?
  xpMultiplier    Float     @default(1.0)
  geogebraEnabled Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  teacher      User              @relation("TeachingClasses", fields: [teacherId], references: [id])
  teacherId    String
  students     ClassEnrollment[]
  modules      Module[]
  achievements ClassAchievement[]
  books        ClassBook[]
  exercises    ClassExercise[]
}

model ClassEnrollment {
  id        String   @id @default(uuid())
  student   User     @relation(fields: [studentId], references: [id])
  studentId String
  class     Class    @relation(fields: [classId], references: [id])
  classId   String
  joinedAt  DateTime @default(now())

  @@unique([studentId, classId])
}

model Progress {
  id          String    @id @default(uuid())
  status      String    @default("not_started") // not_started, in_progress, completed
  score       Int?
  timeSpent   Int       @default(0) // in seconds
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  user        User      @relation(fields: [userId], references: [id])
  userId      String
  material    Material  @relation(fields: [materialId], references: [id])
  materialId  String

  @@unique([userId, materialId])
}

model Achievement {
  id          String    @id @default(uuid())
  title       String
  description String
  icon        String    // emoji or icon name
  unlockedAt  DateTime  @default(now())

  // Relations
  user        User      @relation(fields: [userId], references: [id])
  userId      String
}

// Custom achievements per class, created by teacher
model ClassAchievement {
  id          String   @id @default(uuid())
  title       String
  description String
  icon        String   // emoji or icon name
  xpReward    Int      @default(50)
  condition   String   // JSON: {type: "complete_materials" | "quiz_score" | "complete_module", target: number}
  createdAt   DateTime @default(now())

  // Relations
  class       Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId     String
  unlockedBy  StudentClassAchievement[]
}

// Track which students unlocked which class achievements
model StudentClassAchievement {
  id            String   @id @default(uuid())
  unlockedAt    DateTime @default(now())

  // Relations
  student       User             @relation(fields: [studentId], references: [id])
  studentId     String
  achievement   ClassAchievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  achievementId String

  @@unique([studentId, achievementId])
}

// Books assigned to class by teacher
model ClassBook {
  id          String   @id @default(uuid())
  title       String
  author      String?
  description String?
  coverUrl    String?
  contentType String   @default("rich_text") // "rich_text" | "pdf"
  content     String?  // Rich text content (HTML)
  pdfUrl      String?  // PDF file URL
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  class       Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId     String
}

// Interactive exercises with geometry visualization
model ClassExercise {
  id            String   @id @default(uuid())
  title         String
  description   String?
  instructions  String?  // Instruksi soal dalam HTML/markdown
  exerciseType  String   @default("geometry") // geometry, calculation, mixed
  difficulty    String   @default("medium")   // easy, medium, hard
  points        Int      @default(10)         // XP reward
  
  // Timer settings (optional)
  hasTimer      Boolean  @default(false)
  timerMinutes  Int?     // Durasi dalam menit
  
  // Geometry canvas state (JSON string of CanvasState)
  canvasState   String?
  canvasMode    String   @default("readonly") // readonly, interactive
  
  // Answer configuration
  answerType    String   @default("multiple_choice") // multiple_choice, numeric, canvas, mixed
  correctAnswer String?  // JSON: untuk numeric bisa {value: 42, tolerance: 0.1}
  options       String?  // JSON array: [{id, text, isCorrect}] untuk multiple choice
  
  // Status
  isPublished   Boolean  @default(false)
  order         Int      @default(0)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  class         Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId       String
  attempts      ExerciseAttempt[]
}

// Student exercise attempts
model ExerciseAttempt {
  id          String   @id @default(uuid())
  answer      String?  // JSON: submitted answer
  canvasData  String?  // JSON: submitted canvas state (for canvas answer type)
  isCorrect   Boolean  @default(false)
  score       Int      @default(0)
  timeSpent   Int      @default(0) // in seconds
  
  createdAt   DateTime @default(now())

  // Relations
  student     User          @relation(fields: [studentId], references: [id])
  studentId   String
  exercise    ClassExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  exerciseId  String
  
  @@unique([studentId, exerciseId])
}

