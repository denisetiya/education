{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Geo Education Desktop",
  "version": "0.1.0",
  "identifier": "site.denisetiya.geoeducation.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "pnpm run dev:desktop",
    "beforeBuildCommand": "pnpm run build:desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Geo Education",
        "width": 1440,
        "height": 920,
        "minWidth": 1200,
        "minHeight": 760,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/backend-node"
    ],
    "resources": [
      "resources/backend"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
