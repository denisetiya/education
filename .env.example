# Production environment variables.
# The GitHub Actions deploy workflow writes these values to .env on the VPS.

# GHCR image source. Format: owner/repository.
GITHUB_REPOSITORY=denisetiya/education
IMAGE_TAG=latest

# Backend runtime.
JWT_SECRET=replace-this-with-a-long-random-production-secret
JWT_ISSUER=geo-education
JWT_AUDIENCE=geo-education-app
AUTH_COOKIE_NAME=token
DATABASE_URL=file:/app/data/prod.db
BACKEND_DATA_DIR=./data/backend
REQUEST_BODY_LIMIT=5mb
BCRYPT_ROUNDS=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=400
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# Public app URL used for backend CORS.
FRONTEND_URL=https://geoeducation.denisetiya.site

# Cloudflare Tunnel token.
# Configure the tunnel public hostname in Cloudflare to target http://frontend:80.
CLOUDFLARE_TUNNEL_TOKEN=your-cloudflare-tunnel-token
